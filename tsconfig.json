{
  "compilerOptions": {
    "outDir": "dist",
    "module": "commonjs",
    "target": "ES2017",
    "rootDir": "fontes",
    "allowJs": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true
  },
  "exclude": [
    "babel.config.js", 
    "coverage",
    "dist/**/*", 
    "jest.config.ts",
    "node_modules",
    "testes"
  ]
}
